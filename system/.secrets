#!/usr/bin/env bash

# Shell secrets — loaded from platform-native keyring.
# Use `secrets-manage set <service> <account>` to store values.
# Work-specific secrets live in .secrets.work (from dotfiles-work overlay).

_secret() {
  if is-macos; then
    security find-generic-password -s "dotfiles:$1" -a "$2" -w 2>/dev/null
  elif is-executable secret-tool; then
    # Linux: GNOME/KDE keyring via libsecret
    secret-tool lookup dotfiles_service "dotfiles:$1" dotfiles_account "$2" 2>/dev/null
  else
    # Fallback: encrypted file in ~/.dotfiles/.secrets-store.gpg
    local store="$HOME/.dotfiles/.secrets-store.gpg"
    if [ -f "$store" ]; then
      gpg --batch --quiet --for-your-eyes-only --decrypt "$store" 2>/dev/null \
        | awk -F'\t' -v svc="dotfiles:$1" -v acct="$2" '$1 == svc && $2 == acct { print $3 }'
    fi
  fi
}

# Load secrets into environment
_GITHUB_TOKEN="$(_secret 'github' 'personal-token')"
if [ -n "$_GITHUB_TOKEN" ]; then
  export GITHUB_TOKEN="$_GITHUB_TOKEN"
fi
unset _GITHUB_TOKEN

unset -f _secret

# Publish tokens to GUI session so apps can read them for MCP
if is-macos; then
  for _var in GITHUB_TOKEN; do
    [ -n "${!_var}" ] && launchctl setenv "$_var" "${!_var}"
  done
  unset _var
fi
