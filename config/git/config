[apply]

# Detect whitespace errors when applying a patch

whitespace = fix

[core]

# Use custom `.gitignore` and `.gitattributes`

excludesfile = ~/.config/git/ignore
attributesfile = ~/.config/git/attributes

editor = code --wait
filemode = false
whitespace = trailing-space,space-before-tab,tab-in-indent,cr-at-eol,space-at-eol

# Make `git rebase` safer on macOS

trustctime = false
autocrlf = input
untrackedCache = true
pager = delta --features=diff-so-fancy --dark

[commit]

gpgsign = false

[credential]
helper = osxkeychain

[grep]
lineNumber = true

[help]

# Automatically correct and execute mistyped commands

autocorrect = 3

[push]

default = simple

# Make `git push` push relevant annotated tags when pushing branches out.

followTags = true

[fetch]
prune = true

[pull]
rebase = merges

[status]
relativePaths = false
branch = true

[rebase]
autostash = true
abbreviatecommands = true
stat = true

[sequence]
editor = code --wait

[alias]

# edit this file

configedit = config --global -e

## Logging/status

l = log --pretty=oneline -n 20 --graph --abbrev-commit

lc = log ORIG_HEAD.. --stat --no-merges
lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative

last = log -n 1 HEAD

s = status -s

hardreset = reset HEAD --hard

# Show the diff between the latest commit and the current state

changes = !"git diff-index --quiet HEAD -- || clear; git diff --patch-with-stat"

changesn = !"f() { git diff --patch-with-stat HEAD~$1; }; git diff-index --quiet HEAD -- || clear; f"

review = diff HEAD^ HEAD

br = branch
bra = branch -a

# Show verbose output about tags, branches or remotes

tags = tag -l
branches = branch -a
remotes = remote -v

# List aliases

aliases = config --get-regexp alias
alias = !"git aliases"

## fetching/pulling

f = fetch

## fetch and prune tags

pt = !git tag -l | xargs git tag -d && git fetch -t

p = !"git pull; git submodule update --recursive --remote"
all = !git stash && git fetch && git pull && git stash pop

c = clone --recursive

co = checkout
cob = checkout -b

## committing/pushing

cim = commit -m
ci = '!git-ci'

wip = "!wip() { git add -A && git commit -m \"chore(squash): squash me\" --no-verify; }; wip"

amend = "!f() { if command -v aicommit2 >/dev/null 2>&1 && [ \"$#\" -eq 0 ]; then aicommit2 --amend -a -s -y; else git commit -a --amend \"$@\"; fi; }; f"
remend = commit -a --amend --reuse-message=HEAD

credit = "!credit() { git commit --amend --author \"$1 <$2>\" -C HEAD; }; credit"

squash = "!squash() { git rebase -i HEAD~$1; }; squash"

ra = rebase --abort
rc = rebase --continue
rs = rebase --skip

retag = "!retag() { git tag -d $1 && git push origin :refs/tags/$1 && git tag $1; }; retag"

# Delete local branches whose upstream was removed on the remote (: gone after fetch --prune).
# Phase 1: prompt to remove worktrees whose branch remote is gone (freeing them for deletion).
# Phase 2: delete non-worktree branches whose remote is gone.
# Uses branch -D (not -d): squash merges leave tips not reachable from main, so -d always fails and feels like double confirmation with xargs -p.
# Optional arg: remote to fetch (default origin).

	dm = "!dm() { \
		git fetch \"${1-origin}\" --prune 2>/dev/null || true; \
		git branch -vv | grep '^[+]' | grep ': gone]' | sed -E 's/^[+ ]+([^ ]+) +.*/\\1/' | while read -r branch; do \
			wtpath=$(git worktree list | grep \"\\[$branch\\]\" | awk '{print $1}'); \
			if [ -n \"$wtpath\" ]; then \
				printf 'Remove worktree %s (branch %s, remote gone)? [y/N] ' \"$wtpath\" \"$branch\"; \
				read -r ans </dev/tty; \
				case \"$ans\" in [yY]*) git worktree remove \"$wtpath\" && echo \"  Removed worktree.\";; esac; \
			fi; \
		done; \
		git branch -vv | grep ': gone]' | grep -v '^[*+]' | sed -E 's/^[ *+]+([^ ]+) +.*/\\1/' | xargs -pn1 git branch -D; \
	}; dm"

ignore-files = "!f() { git update-index --assume-unchanged "$@"; }; f"

track-files = "!f() { git update-index --no-assume-unchanged "$@"; }; f"

# Disable line ending conversion for current repo
no-crlf = "!echo '* -text' >> .git/info/attributes && echo 'Line ending conversion disabled for this repo'"

bd = "!git branch -d $1 && echo '' && git branch -l && echo ' (Removed) $1'"
bdf = "!git branch -D $1 && echo '' && git branch -l && echo ' (RemoveD) $1'"
bdlist = "!f() { for branch in "$@"; do git branch -D $branch && echo ' (RemoveD) $branch'; done; }; f"

pu = push
pun = push --no-verify
puta = push --follow-tags

puf = push --force-with-lease
pufn = push --force-with-lease --no-verify

## searching

fb = "!fb() { git branch -a --contains $1; }; fb"

ft = "!ft() { git describe --always --contains $1; }; ft"

fc = "!fc() { git log --pretty=format:'%C(yellow)%h %Cblue%ad %Creset%s%Cgreen [%cn] %Cred%d' --decorate --date=short -S$1; }; fc"

fm = "!fm() { git log --pretty=format:'%C(yellow)%h %Cblue%ad %Creset%s%Cgreen [%cn] %Cred%d' --decorate --date=short --grep=$1; }; fm"

contrib = shortlog --summary --numbered
	rebase-main = !git fetch origin && git rebase origin/main

[diff]

renames = copies

indentHeuristic = true

mnemonicprefix = true
	tool = vscode
colorMoved = default
whitespace = -space-at-eol, -space-before-tab, indent-with-non-tab, cr-at-eol
ignoreWhitespaceChange = true

[diff "bin"]

# Use `hexdump` to diff binary files

textconv = hexdump -v -C

[difftool]
prompt = false

[difftool "delta"]
cmd = delta --diff $LOCAL $REMOTE

[merge]
tool = vscode
conflictstyle = diff3
defaultToUpstream = true

log = true

[mergetool]
prompt = false

[mergetool "vscode"]
cmd = code --wait $MERGED
trustExitCode = false

[color]

ui = auto

interactive = true
[color "branch"]
current = yellow reverse
local = yellow
remote = green
[color "diff"]
meta = yellow bold
frag = magenta bold # line info
old = red           # deletions
new = green         # additions
[color "status"]
added = yellow
changed = green
untracked = cyan
[color "diff-highlight"]
oldNormal = red bold
oldHighlight = red bold 52
newNormal = green bold
newHighlight = green bold 22

[user]
	name = Michael McNamara
	email = mcnamaram@users.noreply.github.com

# Work email/hooks applied conditionally via overlay
[includeIf "hasconfig:remote.*.url:*arcadia*"]
	path = ~/.dotfiles-work/config/git/config.work

[init]
defaultBranch = main

[delta]
features = diff-so-fancy line-numbers decorations inline line-numbers diff-highlight
syntax-theme = Monokai Extended
plus-style = syntax "#012800"
minus-style = syntax "#340001"
side-by-side = true
whitespace = ignore-all-space

[interactive]
diffFilter = delta --color-only
[advice]
	skippedCherryPicks = false
