# Shell
brew "bash"
brew "bash-completion"

# Core UNIX
brew "coreutils"
brew "diffutils"
brew "gawk"
brew "gnu-getopt"
brew "gnu-sed"
brew "grep"
brew "moreutils"
brew "rename"
brew "screen"
brew "tree"
brew "watch"
brew "wget"

# VCS
brew "git"
brew "git-delta"

# Security / crypto
brew "gnupg", link: false
brew "openssh"
brew "openssl@3"

# Languages / runtimes
brew "go"

# Python tooling
brew "uv"
brew "yamllint"

# Data wrangling
brew "jq"
brew "python-yq"

# Docker / Kubernetes
brew "docker-completion"
brew "kind"
brew "kubectx", link: false
brew "kubernetes-cli"

# Editor / dev tools
brew "highlight"
brew "htop"
brew "httpie"
brew "netcat"
brew "nss"
brew "pandoc"
brew "readline"
brew "shellcheck"
brew "shfmt"
brew "stow"
