#!/usr/bin/env bash

# AI tooling functions — home/standard setup.
# Work-specific functions (sync-vscode-settings, etc.) live in .function_ai.work

# Check if Ollama is running; start it if not (macOS) or warn (Linux)

ollama-ready() {
  if ! is-executable ollama; then
    echo "ollama not installed" >&2
    return 1
  fi
  if curl -s http://localhost:11434/api/version &>/dev/null; then
    return 0
  fi
  # macOS: try to start via launchctl
  if is-macos && launchctl list com.ollama.ollama &>/dev/null; then
    echo "Starting Ollama..."
    launchctl start com.ollama.ollama
    sleep 2
    return 0
  fi
  echo "Ollama is not running. Start it with 'ollama serve' (or the macOS app)." >&2
  return 1
}

# List available Ollama models

ollama-list() {
  ollama-ready || return 1
  ollama list
}

# Interactive chat with Ollama

ollama-chat() {
  local MODEL="${1:-llama3}"
  shift || true
  ollama-ready || return 1
  if [ $# -gt 0 ]; then
    ollama run "$MODEL" "$*"
  else
    ollama run "$MODEL"
  fi
}

# Show running Ollama models (memory usage)

ollama-ps() {
  ollama-ready || return 1
  curl -s http://localhost:11434/api/tags | jq -r '.models[] | "\(.name) \(.size/1000000000)GB"' 2>/dev/null || \
    echo "No models loaded"
}
