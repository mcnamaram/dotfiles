#!/usr/bin/env bash

# If not running interactively, don't do anything
case "$-" in
*i*) ;;
*) return ;;
esac

# Resolve DOTFILES_DIR
if [ -d "$HOME/.dotfiles" ]; then
  DOTFILES_DIR="$HOME/.dotfiles"
else
  echo "Unable to find dotfiles, exiting."
  return
fi

# Make utilities available
PATH="$DOTFILES_DIR/bin:$PATH"

# Source standard dotfiles (order matters; skip .work overlay files)
for DOTFILE in "$DOTFILES_DIR"/system/.{env,function,function_*,path,alias,grep,nvm,completion,prompt_bash,iterm,pyenv,direnv,secrets,sdkman}; do
  [[ -f "$DOTFILE" && "$DOTFILE" != *.work ]] && source "$DOTFILE"
done

if is-macos; then
  for DOTFILE in "$DOTFILES_DIR"/system/.{env,alias,function,path}.macos; do
    [ -f "$DOTFILE" ] && source "$DOTFILE"
  done
fi

# Source .work overlay files (from dotfiles-work, symlinked into system/)
for DOTFILE in "$DOTFILES_DIR"/system/.*.work; do
  [ -f "$DOTFILE" ] && source "$DOTFILE"
done

# Set LSCOLORS
eval "$(dircolors -b "$DOTFILES_DIR"/system/.dir_colors)"

# Hook for extra/custom stuff; we'll add more as we need it
DOTFILES_EXTRA_DIR="$HOME/.extra"

if [ -d "$DOTFILES_EXTRA_DIR" ]; then
  for EXTRAFILE in "$DOTFILES_EXTRA_DIR"/.{env,path,secrets}; do
    [ -f "$EXTRAFILE" ] && source "$EXTRAFILE"
  done
fi

# Clean up
if is-executable kubectl.docker; then
  rm -rf "$(command -v kubectl.docker)"
fi

unset DOTFILE EXTRAFILE

# Ensure nvm is available
if is-executable nvm; then
  test -e /usr/local/bin/node && rm /usr/local/bin/node
  ln -sf "$(nvm which "$(nvm current)")" /usr/local/bin/node
fi

# Export
export DOTFILES_DIR DOTFILES_EXTRA_DIR
