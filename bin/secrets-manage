#!/usr/bin/env bash
set -euo pipefail

# Keychain/SecretService CRUD for shell secrets.
# All entries use a "dotfiles:" prefix in the service name for easy filtering.

LABEL_PREFIX="dotfiles:"
PROG=$(basename "$0")

usage() {
  cat <<EOF
Usage: $PROG <command> [args]

Commands:
  set <service> <account>          Store a secret (prompts for value)
  get <service> <account>          Retrieve a secret (silent fail if missing)
  delete <service> <account>       Remove a secret
  list                             List all dotfiles-managed secrets
  import <file>                    Bulk import from a secrets list file
                                   (format: service<TAB>account<TAB>description)

Service names are automatically prefixed with "$LABEL_PREFIX".

Examples:
  $PROG set openai api-key
  $PROG get openai api-key
  $PROG list
  $PROG import setup/secrets.list
EOF
}

_full_service() {
  echo "${LABEL_PREFIX}${1}"
}

# Platform-specific secret backend
_secret_store_backend() {
  if is-macos; then
    echo "macos"
  elif is-executable secret-tool; then
    echo "secret-tool"
  else
    echo "gpg-file"
  fi
}

cmd_set() {
  local service account full_service value
  service="${1:?Usage: $PROG set <service> <account>}"
  account="${2:?Usage: $PROG set <service> <account>}"
  full_service="$(_full_service "$service")"

  echo -n "Enter value for ${service}/${account}: "
  read -rs value
  echo

  if [ -z "$value" ]; then
    echo "Error: empty value, nothing stored." >&2
    return 1
  fi

  case "$(_secret_store_backend)" in
    macos)
      security delete-generic-password -s "$full_service" -a "$account" 2>/dev/null || true
      security add-generic-password -s "$full_service" -a "$account" -w "$value" -T "" -U
      ;;
    secret-tool)
      # secret-tool store replaces; use --replace flag
      secret-tool store --label="${service}/${account}" \
        dotfiles_service "dotfiles:$service" \
        dotfiles_account "$account" "$value" 2>/dev/null || \
      secret-tool store --label="${service}/${account}" \
        dotfiles_service "dotfiles:$service" \
        dotfiles_account "$account" "$value"
      ;;
    gpg-file)
      local store="$HOME/.dotfiles/.secrets-store.gpg"
      if [ -f "$store" ]; then
        local decrypted
        decrypted=$(gpg --batch --quiet --decrypt "$store" 2>/dev/null || echo "")
      else
        decrypted=""
      fi
      # Remove existing entry if present
      local filtered
      filtered=$(echo "$decrypted" | grep -v "^dotfiles:$service	$account	" || true)
      # Add new entry (handle empty store — first entry needs its own line)
      if [ -z "$(echo "$filtered" | tr -d '[:space:]')" ]; then
        printf '%s\t%s\t%s\n' "dotfiles:$service" "$account" "$value" \
          | gpg --batch --quiet --yes --trust-model always -c -o "$store" 2>/dev/null
      else
        printf '%s\n%s\t%s\t%s\n' "$filtered" "dotfiles:$service" "$account" "$value" \
          | gpg --batch --quiet --yes --trust-model always -c -o "$store" 2>/dev/null
      fi
      echo "Stored: ${service}/${account} (encrypted file)"
      return 0
      ;;
  esac

  echo "Stored: ${service}/${account}"
}

cmd_get() {
  local service account full_service
  service="${1:?Usage: $PROG get <service> <account>}"
  account="${2:?Usage: $PROG get <service> <account>}"
  full_service="$(_full_service "$service")"

  case "$(_secret_store_backend)" in
    macos)
      security find-generic-password -s "$full_service" -a "$account" -w 2>/dev/null
      ;;
    secret-tool)
      secret-tool lookup dotfiles_service "dotfiles:$service" dotfiles_account "$account" 2>/dev/null
      ;;
    gpg-file)
      local store="$HOME/.dotfiles/.secrets-store.gpg"
      if [ -f "$store" ]; then
        gpg --batch --quiet --for-your-eyes-only --decrypt "$store" 2>/dev/null \
          | awk -F'\t' -v svc="dotfiles:$service" -v acct="$account" '$1 == svc && $2 == acct { print $3 }'
      fi
      ;;
  esac
}

cmd_delete() {
  local service account full_service
  service="${1:?Usage: $PROG delete <service> <account>}"
  account="${2:?Usage: $PROG delete <service> <account>}"
  full_service="$(_full_service "$service")"

  case "$(_secret_store_backend)" in
    macos)
      if security delete-generic-password -s "$full_service" -a "$account" 2>/dev/null; then
        echo "Deleted: ${service}/${account}"
      else
        echo "Not found: ${service}/${account}" >&2
        return 1
      fi
      ;;
    secret-tool)
      if secret-tool lookup dotfiles_service "dotfiles:$service" dotfiles_account "$account" &>/dev/null; then
        # secret-tool doesn't have delete; clear by overwriting with empty
        secret-tool store --label="" \
          dotfiles_service "dotfiles:$service" \
          dotfiles_account "$account" "" 2>/dev/null || true
        echo "Deleted: ${service}/${account}"
      else
        echo "Not found: ${service}/${account}" >&2
        return 1
      fi
      ;;
    gpg-file)
      local store="$HOME/.dotfiles/.secrets-store.gpg"
      if [ -f "$store" ]; then
        local decrypted
        decrypted=$(gpg --batch --quiet --decrypt "$store" 2>/dev/null || echo "")
        local filtered
        filtered=$(echo "$decrypted" | grep -v "^dotfiles:$service	$account	" || true)
        if [ -z "$(echo "$filtered" | tr -d '[:space:]')" ]; then
          rm -f "$store"
        else
          echo "$filtered" | gpg --batch --quiet --yes --trust-model always -c -o "$store" 2>/dev/null
        fi
        echo "Deleted: ${service}/${account}"
      else
        echo "Not found: ${service}/${account}" >&2
        return 1
      fi
      ;;
  esac
}

cmd_list() {
  echo "Dotfiles-managed secrets in $(echo "$(_secret_store_backend)" | sed 's/secret-tool/Linux keyring/; s/gpg-file/encrypted file store/'):"
  echo "--------------------------------------"
  case "$(_secret_store_backend)" in
    macos)
      security dump-keychain 2>/dev/null \
        | awk -F'"' '
          /\"acct\"<blob>=/ { acct=$4 }
          /\"svce\"<blob>="'"${LABEL_PREFIX}"'/ {
            svc=$4; sub(/^dotfiles:/, "", svc)
            printf "  %s / %s\n", svc, acct
          }
        '
      ;;
    secret-tool)
      # List via secret-tool search (requires secret-tool-search or glib-based tool)
      echo "  (Use 'secret-tool search dotfiles_service' or check your keyring GUI)"
      ;;
    gpg-file)
      local store="$HOME/.dotfiles/.secrets-store.gpg"
      if [ -f "$store" ]; then
        gpg --batch --quiet --decrypt "$store" 2>/dev/null \
          | awk -F'\t' '{ sub(/^dotfiles:/, "", $1); printf "  %s / %s\n", $1, $2 }'
      else
        echo "  (no secrets stored yet)"
      fi
      ;;
  esac
}

cmd_import() {
  local file="${1:?Usage: $PROG import <file>}"

  if [ ! -f "$file" ]; then
    echo "Error: file not found: $file" >&2
    return 1
  fi

  local count=0
  while IFS=$'\t' read -r service account description; do
    [[ -z "$service" || "$service" == \#* ]] && continue

    # Skip if already stored
    if cmd_get "$service" "$account" &>/dev/null; then
      echo "  exists: ${service}/${account} — ${description:-}"
      continue
    fi

    echo -n "  ${description:-${service}/${account}}: "
    read -rs value
    echo

    if [ -n "$value" ]; then
      cmd_set "$service" "$account" <<< "$value"
      count=$((count + 1))
    else
      echo "    skipped (empty)."
    fi
  done < "$file"

  echo "Imported $count secret(s)."
}

case "${1:-}" in
  set)    shift; cmd_set "$@" ;;
  get)    shift; cmd_get "$@" ;;
  delete) shift; cmd_delete "$@" ;;
  list)   cmd_list ;;
  import) shift; cmd_import "$@" ;;
  -h|--help|help) usage ;;
  *)
    usage >&2
    exit 1
    ;;
esac
