#!/usr/bin/env bash

# bash completions

if is-executable brew; then
  BREW_PREFIX=$(brew --prefix)

  if [ -f "$BREW_PREFIX/etc/bash_completion.d/git-completion.bash" ]; then
    source "$BREW_PREFIX/etc/bash_completion.d/git-completion.bash"
  fi
  if [ -f "$BREW_PREFIX/etc/bash_completion.d/git-prompt.sh" ]; then
    source "$BREW_PREFIX/etc/bash_completion.d/git-prompt.sh"
  fi

  source "$BREW_PREFIX/share/bash-completion/bash_completion"
  unset BREW_PREFIX
fi

# Dotfiles command completion
_dotfiles_completions() {
  local cur="${COMP_WORDS[COMP_CWORD]}"
  COMPREPLY=($(compgen -W 'clean dock edit help macos test update' -- $cur))
}

if [ -n "$BASH_VERSION" ]; then
  complete -o default -F _dotfiles_completions dotfiles

  (is-executable npm) && source <(npm completion)
  (is-executable kubectl) && source <(kubectl completion bash)
  (is-executable helm) && source <(helm completion bash)

  if [ -s "$HOME/.bash_completions/open-webui.sh"]; then
    source "$HOME/.bash_completions/open-webui.sh"
  fi

  # kubectx completion — try Homebrew prefix first, then common locations
  for _kctx_dir in \
    "$BREW_PREFIX/opt/kubectx/etc/bash_completion.d" \
    "/opt/homebrew/opt/kubectx/etc/bash_completion.d" \
    "/usr/local/opt/kubectx/etc/bash_completion.d"; do
    [ -d "$_kctx_dir" ] && for f in "$_kctx_dir"/*; do
      [ -f "$f" ] && source "$f"
    done
  done
  unset _kctx_dir

fi

# nvm
if [ -s "$NVM_DIR/bash_completion" ]; then
  source "$NVM_DIR/bash_completion"
fi
