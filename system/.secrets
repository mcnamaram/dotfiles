#!/usr/bin/env bash

# Shell secrets — loaded from macOS Keychain via secrets-manage.
# Use `secrets-manage set <service> <account>` to store values.
# Work-specific secrets live in .secrets.work (from dotfiles-work overlay).

_secret() { security find-generic-password -s "dotfiles:$1" -a "$2" -w 2>/dev/null; }

export OPENAI_API_KEY="$(_secret 'openai' 'api-key')"
export GITHUB_TOKEN="$(_secret 'github' 'personal-token')"

unset -f _secret

# Publish tokens to macOS GUI session so apps like Cursor can read them for MCP
if is-macos; then
  for _var in OPENAI_API_KEY GITHUB_TOKEN; do
    [ -n "${!_var}" ] && launchctl setenv "$_var" "${!_var}"
  done
  unset _var
fi
