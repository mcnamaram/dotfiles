#!/usr/bin/env bash

BIN_NAME=$(basename "$0")
COMMAND_NAME=$1

sub_help() {
  echo "Usage: $BIN_NAME <command>"
  echo
  echo "Commands:"
  echo "   clean            Clean up caches (brew, nvm, gem)"
  if is-macos; then
    echo "   dock             Apply macOS Dock settings"
    echo "   macos            Apply macOS system defaults"
  fi
  echo "   edit             Open dotfiles in IDE"
  echo "   help             This help message"
  echo "   test             Run tests"
  echo "   update           Update packages and pkg managers (OS, brew, npm, gem)"
}

sub_edit() {
  local ide="${DOTFILES_IDE:-code}"  # VS Code as cross-platform default
  if is-macos; then
    if is-executable "code"; then
      ide="code --wait"
    fi
  else
    # Linux: try VS Code, then VSCodium, then leave default
    if is-executable "code"; then
      ide="code"
    elif is-executable "vscodium"; then
      ide="vscodium"
    fi
  fi
  sh -c "$ide \"$DOTFILES_DIR\""
}

sub_test() {
  bats "$DOTFILES_DIR"/test/*.bats
}

sub_update() {
  if is-macos; then
    sudo softwareupdate -i -a 2>/dev/null || true
  fi
  if is-executable brew; then
    brew update
    brew upgrade
  fi
  if is-executable npm; then
    npm install npm -g
    npm update -g
  fi
  if is-executable gem; then
    gem update --system
    gem update
  fi
  if is-executable pip3; then
    pip3 install --upgrade pip && pip3 freeze --local | grep -v '^\-e' | cut -d = -f 1 | xargs -n1 pip3 install -U
  elif is-executable pip; then
    pip install --upgrade pip && pip freeze --local | grep -v '^\-e' | cut -d = -f 1 | xargs -n1 pip install -U
  fi
}

sub_clean() {
  if is-executable brew; then
    brew cleanup
  fi
  if is-executable gem; then
    gem cleanup
  fi
  # shellcheck disable=SC1091
  if [ -n "$NVM_DIR" ] && [ -f "$NVM_DIR/nvm.sh" ]; then
    . "$NVM_DIR/nvm.sh"
    nvm cache clear
  fi
}

sub_macos() {
  for DEFAULTS_FILE in "${DOTFILES_DIR}"/macos/defaults*.sh; do
    # shellcheck disable=SC1090
    echo "Applying ${DEFAULTS_FILE}" && . "${DEFAULTS_FILE}"
  done
  echo "Done. Some changes may require a logout/restart to take effect."
}

sub_dock() {
  # shellcheck disable=SC1091
  . "${DOTFILES_DIR}/macos/dock.sh" && echo "Dock reloaded."
}

case $COMMAND_NAME in
"" | "-h" | "--help")
  sub_help
  ;;
*)
  shift
  sub_"${COMMAND_NAME}" "$@"
  if [ $? = 127 ]; then
    echo "'$COMMAND_NAME' is not a known command or has errors." >&2
    sub_help
    exit 1
  fi
  ;;
esac
